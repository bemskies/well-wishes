DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,.app.github.dev,.githubpreview.dev
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,https://*.app.github.dev,https://*.githubpreview.dev
# Required in production. Keep the PostgreSQL URL private.
# DATABASE_URL=postgres://user:password@host:5432/festive_well_wishes
