DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,.app.github.dev,.githubpreview.dev,yourusername.pythonanywhere.com
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,https://*.app.github.dev,https://*.githubpreview.dev,https://yourusername.pythonanywhere.com
# Enable this on PythonAnywhere to use its persistent home-directory SQLite database.
PYTHONANYWHERE_SITE=False
# Optional on other production hosts; this takes precedence over SQLite.
# DATABASE_URL=postgres://user:password@host:5432/festive_well_wishes
